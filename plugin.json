{
  "manifestVersion": 1,
  "name": "quality-guard",
  "displayName": "模型质量守护",
  "publisher": "jiahao6635",
  "version": "0.1.2",
  "description": "按账号进行 ModelTrace 行为指纹探测，连续异常后移出健康组，复测通过后恢复。",
  "license": "MIT",
  "author": "jiahao6635",
  "engines": {
    "codex-proxy-rs": ">=3.17.0, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "management": {},
    "command_line": {},
    "maintenance": {}
  },
  "permissions": [
    "models",
    "data",
    "groups",
    "keys"
  ],
  "configurationSchema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "account_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 100,
        "uniqueItems": true,
        "default": []
      },
      "model": {
        "type": "string",
        "default": "gpt-6-astra"
      },
      "business_key_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 20,
        "default": []
      },
      "confidence_threshold": {
        "type": "number",
        "minimum": 0.9,
        "maximum": 1,
        "default": 0.99
      },
      "max_daily_attempts": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000,
        "default": 100
      },
      "max_output_tokens": {
        "type": "integer",
        "minimum": 2048,
        "maximum": 16384,
        "default": 4096
      },
      "max_daily_output_tokens": {
        "type": "integer",
        "minimum": 2048,
        "default": 409600
      },
      "probe_daily_usd": {
        "type": "string",
        "default": "5"
      },
      "probe_weekly_usd": {
        "type": "string",
        "default": "25"
      },
      "max_quarantined_percent": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 50
      },
      "policy": {
        "type": "object",
        "properties": {
          "samples_per_round": {
            "type": "integer",
            "minimum": 3,
            "maximum": 10,
            "default": 3
          },
          "anomaly_rounds": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10,
            "default": 2
          },
          "recovery_rounds": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10,
            "default": 2
          },
          "anomaly_spacing_ms": {
            "type": "integer",
            "minimum": 300000,
            "maximum": 86400000,
            "default": 300000
          },
          "recovery_spacing_ms": {
            "type": "integer",
            "minimum": 600000,
            "maximum": 86400000,
            "default": 600000
          },
          "healthy_interval_ms": {
            "type": "integer",
            "minimum": 60000,
            "maximum": 86400000,
            "default": 1800000
          },
          "unknown_retry_ms": {
            "type": "integer",
            "minimum": 60000,
            "maximum": 86400000,
            "default": 300000
          },
          "cooldown_initial_ms": {
            "type": "integer",
            "minimum": 60000,
            "maximum": 86400000,
            "default": 3600000
          },
          "cooldown_max_ms": {
            "type": "integer",
            "minimum": 60000,
            "maximum": 86400000,
            "default": 21600000
          }
        },
        "additionalProperties": false,
        "default": {}
      }
    },
    "additionalProperties": false
  },
  "state": [
    {
      "namespace": "quality",
      "schemaVersion": 1,
      "schema": {
        "type": "object"
      },
      "maximumRecords": 4096,
      "maximumBytes": 4194304,
      "maximumValueBytes": 65536,
      "migratesFrom": []
    }
  ],
  "resources": {
    "legal/notices.txt": "text/plain"
  }
}
